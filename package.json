{
  "name": "my-website",
  "version": "1.0.0",
  "description": "Sairam Krishnan's personal website",
  "private": true,
  "scripts": {
    "rubric": "python3 .claude/rubric/score.py",
    "dev": "python3 .claude/rubric/score.py && python3 -m http.server 4400 --bind 127.0.0.1 --directory .claude/rubric/out/candidate",
    "serve": "python3 .claude/rubric/score.py && python3 -m http.server 4400 --bind 127.0.0.1 --directory .claude/rubric/out/candidate",
    "build": "python3 .claude/rubric/score.py",
    "check": "python3 .claude/rubric/score.py",
    "release": "python3 .claude/rubric/score.py && python3 .claude/rubric/score.py --verify-review",
    "preview": "python3 .claude/rubric/score.py && python3 -m http.server 4400 --bind 127.0.0.1 --directory .claude/rubric/out/candidate",
    "deploy:build": "python3 .claude/rubric/score.py --deploy-build",
    "deploy:check": "python3 .claude/rubric/score.py --deploy-check",
    "sync:deck": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-deck.mts"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "gsap": "^3.15.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.63.0"
  }
}
