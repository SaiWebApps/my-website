---
import type { LeadershipCaseStudy } from '@/data/content';
interface Props { item: LeadershipCaseStudy; index?: number; }
const { item, index = 0 } = Astro.props;
---
<article class="leadership-study" id={item.slug}>
  <header>
    <span class="record-number">{String(index + 1).padStart(2, '0')} · {item.organization}</span>
    <h2>{item.title}</h2>
    {item.narrative && <p class="study-thesis">{item.narrative}</p>}
  </header>
  <div class={`study-topology topology-${item.slug}`} aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="study-spine">
    <section><h3>Situation</h3><p>{item.situation}</p></section>
    <section><h3>Responsibility</h3><p>{item.responsibility}</p></section>
    <section><h3>Decisions</h3><ol>{item.decisions.map((decision) => <li>{decision}</li>)}</ol></section>
    <section><h3>Scope</h3><p>{item.scope}</p></section>
    <section class="study-result"><h3>Result</h3><p>{item.result}</p></section>
  </div>
  {item.metrics && <div class="study-metrics">{item.metrics.map((metric) => <p><strong>{metric.value}</strong><span>{metric.label}</span></p>)}</div>}
  {item.testimonial && <figure class="study-testimony"><blockquote>“{item.testimonial.quote}”</blockquote><figcaption>{item.testimonial.person}<span>{item.testimonial.role}</span></figcaption></figure>}
</article>
