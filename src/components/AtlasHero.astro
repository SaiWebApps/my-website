---
import { careerLedger } from '@/data/career';
const W = 980, H = 720;
const X = (yr: number) => 90 + ((yr - 2010) / 16) * (W - 220);
const Y = (lvl: number) => 130 + ((6.3 - lvl) / 6.3) * (H - 300);
const mids: Record<string, number> = { cmu: 2012, leanfm: 2013.5, aws: 2014.4, microsoft: 2015.6, sig: 2017, amazon: 2019.5, apple: 2022.9, wharton: 2025.1, praxtera: 2025.8 };
const drawLevel: Record<string, number> = { cmu: 0, leanfm: 0.7, aws: 1.4, microsoft: 2.1, sig: 3, amazon: 4, apple: 5, wharton: 5.45, praxtera: 6.3 };
const anchors: Record<string, ['start' | 'end', number]> = {
  cmu: ['start', 26], leanfm: ['start', -18], aws: ['end', -18], microsoft: ['start', 24],
  sig: ['start', -18], amazon: ['end', -18], apple: ['start', 24], wharton: ['end', -18], praxtera: ['end', -18],
};
const stars = careerLedger.map((e) => ({
  id: e.id, org: e.org, dates: e.dates, kind: e.kind,
  x: X(mids[e.id]), y: Y(drawLevel[e.id]), r: 3.6 + e.level * 1.35,
  anchor: anchors[e.id][0], dy: anchors[e.id][1],
}));
const byId = Object.fromEntries(stars.map((s) => [s.id, s]));
const path = ['cmu', 'leanfm', 'aws', 'microsoft', 'sig', 'amazon', 'apple'];
const lines = path.slice(1).map((id, i) => ({ a: byId[path[i]], b: byId[id] }));
const branches = [{ a: byId.apple, b: byId.wharton }, { a: byId.apple, b: byId.praxtera }];
const metrics = [
  { value: '$40M', label: 'Saved per year', detail: 'Alexa Core Engine' },
  { value: '100M+', label: 'Users served', detail: 'Apple knowledge graph' },
  { value: '8', label: 'Engineers led', detail: 'Three continents' },
  { value: '10', label: 'Vendors managed', detail: 'Apple' },
  { value: '11', label: 'Years', detail: 'Apple · Amazon · Microsoft · SIG' },
  { value: '54', label: 'Open-source repos', detail: 'Shipped by hand' },
];
const domeY = [-15, -37, -49, -49, -37, -15];
---
<section class="sky-hero" aria-labelledby="hero-title" data-skyhero>
  <div class="sky-hero-inner shell">
    <div class="sky-copy">
      <p class="role-line">Engineering Leadership · AI &amp; ML</p>
      <h1 id="hero-title" class="console-title"><span>Grow the people.</span><span class="console-title-accent">The platforms follow.</span></h1>
      <p class="hero-summary">AI/ML Engineering Leader at Apple<br />Wharton Executive MBA 2026</p>
      <div class="hero-actions console-actions" aria-label="Start a conversation">
        <a class="console-action console-action-primary" href="mailto:sairambkrishnan@gmail.com?subject=Senior%20Engineering%20Manager%20conversation" data-analytics="leadership_role_inquiry">Discuss a leadership role</a>
      </div>
      <nav class="hero-profiles" aria-label="Profiles">
        <a href="https://linkedin.com/in/sairambkrishnan" rel="me">LinkedIn</a>
        <a href="/assets/Sairam_Krishnan_Resume.pdf" data-analytics="resume_download">R&eacute;sum&eacute;</a>
        <a href="https://github.com/SaiWebApps" rel="me">GitHub</a>
        <a href="https://orcid.org/0009-0004-2626-1273" rel="me">ORCID</a>
      </nav>
      <figure class="observer">
        <img src="/assets/portrait-2026.webp" alt="Sairam Krishnan" width="1200" height="1500" fetchpriority="high" />
      </figure>
    </div>

    <figure class="sky-chart" aria-label="Career, 2010 to 2026">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="sky-desc">
        <desc id="sky-desc">Nine roles from 2010 to 2026 drawn as a constellation, rising from Carnegie Mellon to Apple, Wharton, and Praxtera.</desc>
        <defs>
          <filter id="sky-bloom" x="-140%" y="-140%" width="380%" height="380%"><feGaussianBlur stdDeviation="3.4" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
        </defs>
        <g class="atlas-lines" aria-hidden="true">
          {lines.map((l, i) => <line x1={l.a.x} y1={l.a.y} x2={l.b.x} y2={l.b.y} style={`--k:${i}`} />)}
          {branches.map((l, i) => <line x1={l.a.x} y1={l.a.y} x2={l.b.x} y2={l.b.y} style={`--k:${i + 6}`} class="atlas-branch" />)}
        </g>
        <g class="atlas-reticle" aria-hidden="true" transform={`translate(${byId.apple.x} ${byId.apple.y})`}>
          <circle r="20" />
          {[0, 90, 180, 270].map((a) => <line transform={`rotate(${a})`} x1="0" y1="-27" x2="0" y2="-15" />)}
        </g>
        {stars.map((s, i) => (
          <a href={`#career-${s.id}`} class="atlas-star" data-kind={s.kind} style={`--k:${i}`} aria-label={`${s.org}, ${s.dates}`}>
            <circle cx={s.x} cy={s.y} r={s.r + 10} class="atlas-halo" />
            <g class="atlas-star-cross"><line x1={s.x - s.r - 8} y1={s.y} x2={s.x + s.r + 8} y2={s.y} /><line x1={s.x} y1={s.y - s.r - 8} x2={s.x} y2={s.y + s.r + 8} /></g>
            <circle cx={s.x} cy={s.y} r={s.r} class="atlas-core" filter="url(#sky-bloom)" />
            <text x={s.anchor === 'start' ? s.x + s.r + 12 : s.x - s.r - 12} y={s.y + s.dy} text-anchor={s.anchor} class="atlas-name">{s.org}</text>
            <text x={s.anchor === 'start' ? s.x + s.r + 12 : s.x - s.r - 12} y={s.y + s.dy + 16} text-anchor={s.anchor} class="atlas-dates">{s.dates}</text>
          </a>
        ))}
        <g class="sky-pulses" aria-hidden="true">
          <circle r="3.6" class="topo-pulse" filter="url(#sky-bloom)">
            <animateMotion dur="6s" repeatCount="indefinite" begin="1.6s" path={`M${byId.cmu.x} ${byId.cmu.y} L${byId.leanfm.x} ${byId.leanfm.y} L${byId.aws.x} ${byId.aws.y} L${byId.microsoft.x} ${byId.microsoft.y} L${byId.sig.x} ${byId.sig.y} L${byId.amazon.x} ${byId.amazon.y} L${byId.apple.x} ${byId.apple.y}`} />
          </circle>
        </g>
      </svg>
    </figure>
  </div>

  <div class="dome-rail" aria-label="Leadership at a glance">
    <svg viewBox="0 0 1200 130" preserveAspectRatio="none" aria-hidden="true"><path d="M0 115 Q 600 8 1200 115" /></svg>
    <ul>
      {metrics.map((m, i) => (
        <li style={`--dy:${domeY[i]}px`}>
          <strong>{m.value}</strong>
          <span>{m.label}<br />{m.detail}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-skyhero]');
  if (hero) requestAnimationFrame(() => (hero.dataset.entered = 'true'));
</script>
