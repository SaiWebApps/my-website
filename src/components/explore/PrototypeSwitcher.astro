---
import { prototypeRoutes } from '@/data/prototype';

interface Props { current?: string }
const { current = '/explore' } = Astro.props;
---

<nav class="prototype-bar" aria-label="Prototype directions" data-prototype-switcher>
  <a class="prototype-home" href="/explore" aria-label="Prototype comparison" aria-current={current === '/explore' ? 'page' : undefined}>×</a>
  {prototypeRoutes.map((route) => (
    <a href={route.href} aria-current={current === route.href ? 'page' : undefined}>
      <span class="full-label">{route.label}</span><span class="short-label">{route.short}</span>
    </a>
  ))}
</nav>

<script>
  const routes = ['/explore/electric-margins', '/explore/night-signal', '/explore/curious-machine', '/explore/material-intelligence'];
  const switcher = document.querySelector('[data-prototype-switcher]');
  const portrait = document.querySelector('img[src="/assets/portrait-2026.jpg"]');
  if (switcher instanceof HTMLElement && portrait instanceof HTMLImageElement) {
    const observer = new IntersectionObserver(([entry]) => {
      const hidden = entry.isIntersecting;
      switcher.classList.toggle('is-portrait-near', hidden);
      switcher.toggleAttribute('inert', hidden);
      switcher.setAttribute('aria-hidden', String(hidden));
    }, { threshold: 0.08 });
    observer.observe(portrait);
  }
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    const target = event.target;
    if (target instanceof HTMLElement && (target.matches('input, textarea, [contenteditable="true"]'))) return;
    const current = routes.indexOf(window.location.pathname.replace(/\/$/, ''));
    if (current === -1) return;
    const delta = event.key === 'ArrowRight' ? 1 : -1;
    window.location.href = routes[(current + delta + routes.length) % routes.length];
  });
</script>

<style>
  .short-label { display: none; }
  @media (max-width: 640px) {
    .short-label { display: inline; }
  }
</style>
