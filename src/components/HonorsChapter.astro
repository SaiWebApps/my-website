---
type Letter = { img: string; pdf: string; label: string; date: string };
type Honor = { year: string; title: string; detail: string; org: string; mag: number; featured?: boolean; citation?: string[]; attribution?: string; letters?: Letter[] };
const honors: Honor[] = [
  {
    year: '2026', title: 'Benjamin Franklin Award', detail: 'Peer-voted · one of three in a class of 250', org: 'The Wharton School', mag: 6, featured: true,
    citation: [
      'Sairam stands out for the consistency and substance he brought to every aspect of the program. He was always well-prepared, contributed thoughtfully, and had a clear ability to connect classroom concepts to practical, real-world situations in a way that benefited the broader discussion.',
      'Equally important is how he supported those around him. Sairam was generous with his time and knowledge, readily offering help and insight to classmates and strengthening team outcomes without seeking recognition. He approached his work with focus and discipline, while maintaining a collaborative, grounded presence.',
    ],
    attribution: 'Wharton EMBA Global · Class of 2026',
  },
  { year: '2026', title: 'Palmer Scholar', detail: 'Top 5% of the graduating class by cumulative GPA', org: 'The Wharton School', mag: 5 },
  { year: '2026', title: 'Graduation With Honors', detail: 'Top 20% of the graduating class by cumulative GPA', org: 'The Wharton School', mag: 4 },
  {
    year: '2025', title: 'First Year Honors', detail: 'Top 20% of the class over the first three terms', org: 'The Wharton School', mag: 4,
    letters: [{ img: '/letters/first-year-honors.png', pdf: '/letters/first-year-honors.pdf', label: 'First Year Honors', date: 'Jun 13, 2025' }],
  },
  {
    year: '2024–25', title: "Director's List", detail: 'Top 10% of the class · all six terms', org: 'The Wharton School', mag: 5,
    letters: [
      { img: '/letters/directors-list-summer-2024.png', pdf: '/letters/directors-list-summer-2024.pdf', label: 'Summer 2024', date: 'Oct 17, 2024' },
      { img: '/letters/directors-list-fall-2024.png', pdf: '/letters/directors-list-fall-2024.pdf', label: 'Fall 2024', date: 'Feb 4, 2025' },
      { img: '/letters/directors-list-spring-2025.png', pdf: '/letters/directors-list-spring-2025.pdf', label: 'Spring 2025', date: 'Jun 13, 2025' },
    ],
  },
  { year: '2012–14', title: "Dean's List", detail: 'All three years', org: 'Carnegie Institute of Technology', mag: 3 },
  { year: '2010', title: 'Jesse Jones Scholarship', detail: 'Houston Endowment', org: 'Houston Endowment', mag: 2 },
  { year: '2010', title: 'National Merit Finalist', detail: 'National Merit Scholarship Program', org: 'National Merit Scholarship Program', mag: 2 },
];
---
<section class="honors" id="honors" aria-labelledby="honors-title" data-honors>
  <header class="career-head shell honors-head">
    <h2 id="honors-title">Honors &amp; Distinctions<span class="accent-stop">.</span></h2>
    <div class="deck-nav">
      <button type="button" data-deck-prev aria-label="Previous honors"><i class="ph ph-arrow-left" aria-hidden="true"></i></button>
      <button type="button" data-deck-next aria-label="Next honors"><i class="ph ph-arrow-right" aria-hidden="true"></i></button>
    </div>
  </header>

  <ol class="honors-deck" data-deck tabindex="0" aria-label="Honors">
    {honors.map((h) => (
      <li class:list={['honor-card', { 'honor-card-featured': h.featured }]}>
        <svg class="honor-star" viewBox="0 0 40 40" aria-hidden="true">
          <line x1="20" y1={16 - h.mag} x2="20" y2={24 + h.mag} />
          <line x1={16 - h.mag} y1="20" x2={24 + h.mag} y2="20" />
          <circle cx="20" cy="20" r={2 + h.mag * 0.9} />
          {h.featured && <circle cx="20" cy="20" r="15" class="honor-star-ring" />}
        </svg>
        <span class="honor-year">{h.year}</span>
        <h3 class="honor-title">{h.title}</h3>
        <p class="honor-detail">{h.detail}</p>
        {h.citation && (
          <blockquote class="honor-citation">
            {h.citation.map((c) => <p>&ldquo;{c}&rdquo;</p>)}
          </blockquote>
        )}
        {h.attribution && <p class="honor-attribution">{h.attribution}</p>}
        {h.letters && (
          <ul class="honor-letters" data-count={h.letters.length}>
            {h.letters.map((l) => (
              <li>
                <a href={l.pdf} target="_blank" rel="noopener">
                  <img src={l.img} alt={`${l.label} letter`} loading="lazy" width="850" height="1100" />
                  <span>{l.label}<br />{l.date}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
        <span class="honor-org">{h.org}</span>
      </li>
    ))}
  </ol>
</section>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-honors]');
  if (wrap) {
    const deck = wrap.querySelector<HTMLElement>('[data-deck]')!;
    const step = () => (deck.querySelector<HTMLElement>('.honor-card')?.getBoundingClientRect().width ?? 320) + 24;
    wrap.querySelector('[data-deck-prev]')?.addEventListener('click', () => deck.scrollBy({ left: -step(), behavior: 'smooth' }));
    wrap.querySelector('[data-deck-next]')?.addEventListener('click', () => deck.scrollBy({ left: step(), behavior: 'smooth' }));
    let down = false, sx = 0, sl = 0, moved = false;
    deck.addEventListener('pointerdown', (e) => { down = true; moved = false; sx = e.clientX; sl = deck.scrollLeft; });
    deck.addEventListener('pointermove', (e) => { if (!down) return; if (Math.abs(e.clientX - sx) > 6) { moved = true; deck.setPointerCapture(e.pointerId); } deck.scrollLeft = sl - (e.clientX - sx); });
    ['pointerup', 'pointercancel'].forEach((t) => deck.addEventListener(t, () => { down = false; }));
    deck.addEventListener('click', (e) => { if (moved) { e.preventDefault(); moved = false; } }, true);
  }
</script>
