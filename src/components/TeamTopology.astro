---
const cities = [
  { name: 'Seattle', y: 70 },
  { name: 'Cupertino', y: 118 },
  { name: 'Washington, DC', y: 166 },
  { name: 'London', y: 214 },
  { name: 'Amsterdam', y: 262 },
  { name: 'Bangalore', y: 310 },
];
const outputs = [
  { name: 'Search', y: 120 },
  { name: 'Recommendations', y: 190 },
  { name: 'Discovery', y: 260 },
];
const hub = { x: 300, y: 190 };
const cityX = 118;
const outX = 452;
const wire = (x1: number, y1: number, x2: number, y2: number) => { const dx = (x2 - x1) * 0.5; return `M${x1} ${y1} C${x1 + dx} ${y1} ${x2 - dx} ${y2} ${x2} ${y2}`; };
const vendors = Array.from({ length: 10 }, (_, i) => ({ x: 34 + (i % 5) * 14, y: 352 + Math.floor(i / 5) * 14 }));
---
<figure class="topology" data-topology aria-label="Team and platform">
  <svg viewBox="0 0 600 400" role="img" aria-labelledby="topology-title">
    <title id="topology-title">Engineers in Seattle, Cupertino, Washington DC, London, Amsterdam, and Bangalore, with ten vendors, feed one knowledge graph that powers Search, Recommendations, and Discovery for more than 100 million users.</title>
    <defs>
      <linearGradient id="topo-beam" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="var(--accent)" stop-opacity=".0" /><stop offset=".5" stop-color="var(--accent)" stop-opacity=".9" /><stop offset="1" stop-color="var(--accent)" stop-opacity=".0" /></linearGradient>
      <filter id="topo-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
    </defs>

    <g class="topo-labels" aria-hidden="true">
      <text x="24" y="40">Team</text>
      <text x={hub.x} y="40" text-anchor="middle">Platform</text>
      <text x="576" y="40" text-anchor="end">Serves</text>
    </g>

    <g class="topo-wires" aria-hidden="true">
      {cities.map((c, i) => <path d={wire(cityX + 8, c.y, hub.x - 30, hub.y)} style={`--k:${i}`} data-wire />)}
      {outputs.map((o, i) => <path d={wire(hub.x + 30, hub.y, outX - 8, o.y)} style={`--k:${i + 6}`} data-wire />)}
      <path d={`M${vendors[4].x + 8} ${vendors[0].y + 7} C 180 360 220 240 ${hub.x - 24} ${hub.y + 16}`} style="--k:9" data-wire class="topo-vendor-wire" />
    </g>

    <g class="topo-cities" aria-hidden="true">
      {cities.map((c) => (
        <g transform={`translate(${cityX} ${c.y})`}>
          <circle r="4" />
          <text x="-12" y="4" text-anchor="end">{c.name}</text>
        </g>
      ))}
    </g>

    <g class="topo-vendors" aria-hidden="true">
      {vendors.map((v) => <circle cx={v.x} cy={v.y} r="2.4" />)}
      <text x="24" y="392">10 vendors · South America</text>
    </g>

    <g class="topo-hub" transform={`translate(${hub.x} ${hub.y})`} aria-hidden="true">
      <circle r="44" class="topo-hub-ring" />
      <circle r="30" class="topo-hub-ring topo-hub-ring-inner" />
      <circle r="6" class="topo-hub-core" />
      <text y="70" text-anchor="middle">Knowledge graph</text>
    </g>

    <g class="topo-outputs" aria-hidden="true">
      {outputs.map((o) => (
        <g transform={`translate(${outX} ${o.y})`}>
          <circle r="4" />
          <text x="12" y="4">{o.name}</text>
        </g>
      ))}
      <text x="576" y="330" text-anchor="end" class="topo-users">100M+ users</text>
    </g>

    <g class="topo-pulses" aria-hidden="true">
      <circle r="3.5" class="topo-pulse" filter="url(#topo-glow)">
        <animateMotion dur="5.2s" repeatCount="indefinite" begin="1.4s" calcMode="spline" keySplines="0.16 1 0.3 1" keyTimes="0;1" path={wire(cityX + 8, cities[1].y, hub.x - 30, hub.y) + ' ' + wire(hub.x + 30, hub.y, outX - 8, outputs[0].y).replace(/^M[^C]*/, '')} />
      </circle>
      <circle r="3.5" class="topo-pulse" filter="url(#topo-glow)">
        <animateMotion dur="5.2s" repeatCount="indefinite" begin="4s" calcMode="spline" keySplines="0.16 1 0.3 1" keyTimes="0;1" path={wire(cityX + 8, cities[3].y, hub.x - 30, hub.y) + ' ' + wire(hub.x + 30, hub.y, outX - 8, outputs[2].y).replace(/^M[^C]*/, '')} />
      </circle>
    </g>
  </svg>
</figure>

<script>
  const topo = document.querySelector<HTMLElement>('[data-topology]');
  if (topo) {
    topo.querySelectorAll<SVGPathElement>('[data-wire]').forEach((p) => p.style.setProperty('--len', String(p.getTotalLength())));
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) topo.dataset.entered = 'true';
    else {
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { topo.dataset.entered = 'true'; io.disconnect(); } }, { threshold: .3 });
      io.observe(topo);
    }
  }
</script>
