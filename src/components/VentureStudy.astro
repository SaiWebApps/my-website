---
import type { Venture } from '@/data/content';
interface Props { venture: Venture; index: number; }
const { venture, index } = Astro.props;
---

<article class="venture-study" id={venture.slug}>
  <div class="venture-heading">
    <span class="record-number">{String(index + 1).padStart(2, '0')}</span>
    <h2>{venture.name}</h2>
    <p>{venture.thesis}</p>
  </div>
  <figure class={`venture-diagram venture-diagram-${venture.slug}`} aria-label={`${venture.name} system diagram`}>
    {venture.slug === 'ondoway' && (
      <svg viewBox="0 0 320 220" role="img"><title>Ondoway provenance knowledge layers</title><g class="mini-plane"><path d="M55 160 160 110 266 151 160 204Z"/><path d="M72 126 160 84 249 119 160 164Z"/><path d="M89 92 160 58 232 86 160 123Z"/></g><path class="mini-flow" d="M160 188V42"/><g class="mini-node"><circle cx="160" cy="188" r="5"/><circle cx="160" cy="145" r="5"/><circle cx="160" cy="102" r="5"/><circle cx="160" cy="58" r="5"/></g></svg>
    )}
    {venture.slug === 'persuaider' && (
      <svg viewBox="0 0 320 220" role="img"><title>Persuaider conversation and evaluation loop</title><g class="mini-orbit"><ellipse cx="160" cy="111" rx="96" ry="62"/><ellipse cx="160" cy="111" rx="55" ry="92"/><path d="M64 111H256M160 19V203"/></g><g class="mini-node"><circle cx="160" cy="111" r="13"/><circle cx="64" cy="111" r="6"/><circle cx="256" cy="111" r="6"/><circle cx="160" cy="19" r="6"/><circle cx="160" cy="203" r="6"/></g></svg>
    )}
    {venture.slug === 'lore' && (
      <svg viewBox="0 0 320 220" role="img"><title>Lore dependency intelligence layers</title><g class="mini-plane"><path d="M55 167 160 118 266 159 160 210Z"/><path d="M55 125 160 76 266 117 160 168Z"/><path d="M55 83 160 34 266 75 160 126Z"/></g><path class="mini-flow" d="M160 198V22"/><g class="mini-node"><circle cx="160" cy="198" r="5"/><circle cx="160" cy="156" r="5"/><circle cx="160" cy="114" r="5"/><circle cx="160" cy="72" r="5"/><circle cx="160" cy="30" r="5"/></g></svg>
    )}
    {venture.slug === 'crucible' && (
      <svg viewBox="0 0 320 220" role="img"><title>Crucible constraint and verification lattice</title><g class="mini-cube"><path d="M73 77 160 34 247 77 160 121Z"/><path d="M73 77V165L160 208V121M247 77V165L160 208"/><path d="M73 121 160 77 247 121M73 165 160 121 247 165"/></g><g class="mini-node">{[[73,77],[160,34],[247,77],[160,77],[73,121],[160,121],[247,121],[73,165],[160,165],[247,165],[160,208]].map(([cx,cy]) => <circle cx={cx} cy={cy} r="4"/>)}</g></svg>
    )}
  </figure>
  <dl class="venture-fields">
    <div><dt>Problem</dt><dd>{venture.problem}</dd></div>
    <div><dt>Role</dt><dd>{venture.role}</dd></div>
    <div><dt>System</dt><dd>{venture.system}</dd></div>
    <div><dt>Current state</dt><dd>{venture.state}</dd></div>
    <div><dt>Lesson</dt><dd>{venture.lesson}</dd></div>
  </dl>
</article>
