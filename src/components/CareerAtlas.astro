---
import { careerLedger } from '@/data/career';

---
<section class="career shell" id="career" aria-labelledby="career-title">
  <header class="career-head">
    <h2 id="career-title">Engineer to Leader<span class="accent-stop">.</span></h2>
  </header>

  <ol class="career-list" aria-label="Career, in full">
    {careerLedger.map((entry, i) => (
      <li class="career-row" id={`career-${entry.id}`} data-kind={entry.kind} style={`--i:${i}`}>
        <div class="career-when"><span class="career-dates">{entry.dates}</span></div>
        <div class="career-what">
          <h3 class="career-org">{entry.org}</h3>
          <p class="career-role">{entry.role}{entry.meta && <span class="career-meta"> · {entry.meta}</span>}</p>
          <ul class="career-bullets">{entry.bullets.map((bl) => <li>{bl.text}</li>)}</ul>
        </div>
      </li>
    ))}
  </ol>
</section>

<script>
  const root = document.querySelector<HTMLElement>('#career');
  if (root) {
    const rows = root.querySelectorAll<HTMLElement>('.career-row');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) rows.forEach((r) => (r.dataset.seen = 'true'));
    else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { (e.target as HTMLElement).dataset.seen = 'true'; io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -14% 0px', threshold: 0.15 });
      rows.forEach((r) => io.observe(r));
    }
  }
</script>
