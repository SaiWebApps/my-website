---
interface Props { active: 'home' | 'career' | 'projects' | 'research' | 'speaking' | 'services' | 'contact' }
const { active } = Astro.props;
const links = [
  { id: 'services', label: 'Services', href: '/services' },
  { id: 'speaking', label: 'Speaking', href: '/speaking' },
  { id: 'career', label: 'Career', href: '/career' },
  { id: 'resume', label: 'Resume', href: '/assets/Sairam_Krishnan_Resume.pdf' },
  { id: 'research', label: 'Research', href: '/research' },
  { id: 'projects', label: 'Projects', href: '/projects' },
  { id: 'contact', label: 'Contact', href: '/contact' },
] as const;
---
<header class="site-header" id="top">
  <a class="identity" href="/" aria-label="Sairam Krishnan, home">
    <img src="/assets/portrait-2026-mobile.webp" alt="" width="44" height="44" />
    <span>Sairam Krishnan</span>
  </a>
  <nav class="primary-nav" aria-label="Main navigation">
    {links.map(link => <a href={link.href} aria-current={active === link.id ? 'page' : undefined} target={link.id === 'resume' ? '_blank' : undefined} rel={link.id === 'resume' ? 'noopener' : undefined}>{link.label}</a>)}
  </nav>
</header>
