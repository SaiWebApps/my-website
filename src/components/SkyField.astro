---
const seed = (n: number) => { const v = Math.sin(n * 999) * 10000; return v - Math.floor(v); };
const dust = Array.from({ length: 260 }, (_, i) => ({ x: seed(i) * 1600, y: seed(i + 300) * 1000, r: seed(i + 600) * 1.2 + 0.3, o: 0.1 + seed(i + 900) * 0.42 }));
const sparks = dust.filter((_, i) => i % 19 === 0);
---
<div class="skyfield" aria-hidden="true">
  <svg viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice">
    <g class="sky-dust">
      {dust.map((d) => <circle cx={d.x} cy={d.y} r={d.r} style={`opacity:${d.o}`} />)}
      {sparks.map((d) => <g style={`opacity:${d.o + 0.18}`}><line x1={d.x - 5} y1={d.y} x2={d.x + 5} y2={d.y} /><line x1={d.x} y1={d.y - 5} x2={d.x} y2={d.y + 5} /></g>)}
    </g>
    <g class="sky-arcs">
      <path d="M-50 780 Q 800 560 1650 780" />
      <path d="M-50 980 Q 800 760 1650 980" />
      <path d="M-50 240 Q 800 460 1650 240" />
    </g>
  </svg>
</div>
