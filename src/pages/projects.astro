---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ventures } from '../data/content';
import githubClusters from '../data/githubClusters.json';
import '../styles/inner-pages.css';

const repos: Record<string, string> = {
  ondoway: 'https://github.com/SaiWebApps/Ondoway',
  persuaider: 'https://github.com/SaiWebApps/persuaider',
  lore: 'https://github.com/SaiWebApps/DependIQ',
  crucible: 'https://github.com/SaiWebApps/claude-kit',
};
const extraLinks: Record<string, { href: string; label: string }[]> = {
  ondoway: [{ href: '/projects/ondoway/user-journey', label: 'User journey' }],
};
const descriptions: Record<string, string> = {
  ondoway: 'Location-aware audio tours grounded in sourced stories.',
  persuaider: 'AI-assisted negotiation practice and evaluation.',
  lore: 'Cross-project dependency analysis for software teams.',
  crucible: 'Engineering checks for AI coding agents.',
};
---
<SiteLayout title="Side Projects — Sairam Krishnan" description="Products and tools built by Sairam Krishnan, including Ondoway, Persuaider, DependIQ, and Crucible.">
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader active="projects" />
  <main id="main" class="inner-page">
    <section class="inner-hero simple-hero" aria-labelledby="projects-title"><h1 id="projects-title" data-reveal>Side Projects.</h1></section>
    <section class="project-grid" aria-label="Featured projects">
      {ventures.map(project => <article class="project-card" id={project.slug} data-reveal>
        <h2>{project.name}</h2>
        <p class="project-thesis">{descriptions[project.slug]}</p>
        <div class="project-links"><a href={repos[project.slug]} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.name} on GitHub`}>GitHub ↗</a>{extraLinks[project.slug]?.map(link => <a href={link.href} target="_blank" rel="noopener" aria-label={`View the ${project.name} ${link.label.toLowerCase()}`}>{link.label} ↗</a>)}</div>
        <details class="project-more">
          <summary>Details</summary>
          <dl class="project-facts"><div><dt>Problem</dt><dd>{project.problem}</dd></div><div><dt>My role</dt><dd>{project.role}</dd></div><div><dt>What exists now</dt><dd>{project.state}</dd></div><div><dt>Built with</dt><dd>{project.system}</dd></div></dl>
        </details>
      </article>)}
    </section>
    <section class="repo-archive" aria-labelledby="repo-title">
      <h2 id="repo-title">And more…</h2>
      <div class="repo-clusters">
        {githubClusters.map(group => <details class="repo-cluster" data-reveal>
          <summary><span>{group.title}</span><span>{group.projects.length} repositories</span></summary>
          <ul>{group.projects.map(project => <li><div class="repo-links"><a href={`https://github.com/SaiWebApps/${encodeURIComponent(project.name)}`} target="_blank" rel="noopener noreferrer">{project.name} on GitHub ↗</a>{'registry' in project && project.registry && <a href={project.registry.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.name} on ${project.registry.label}`}>{project.registry.label} ↗</a>}</div><p>{project.description}</p></li>)}</ul>
        </details>)}
      </div>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>
