---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { research } from '../data/content';
import { personId, fullTitle, profiles } from '../data/seo';
import '../styles/inner-pages.css';
const linkLabels: Record<string, string> = {
  'who-trains-the-next-senior': 'Read the management paper',
  'ai-roi': 'Read the AI ROI paper',
  'drone-megaddon-2026': 'Read the 2026 swarm paper',
  'drone-megaddon': 'Read the 2014 swarm paper',
};
const schema = research.map(paper => {
  const [publisher, year] = paper.venue.split(', ');
  return {
    '@type': 'ScholarlyArticle',
    '@id': paper.href,
    url: paper.href,
    headline: fullTitle(paper.title, paper.subtitle),
    name: paper.title,
    description: paper.summary,
    datePublished: year,
    publisher: { '@type': 'Organization', name: publisher },
    identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: paper.href?.replace('https://doi.org/', '') },
    author: paper.authors.split(', ').map(name => name === 'Sairam Krishnan' ? { '@id': personId } : { '@type': 'Person', name }),
  };
});
const profileLinks = [
  { label: 'Google Scholar', href: profiles.scholar },
  { label: 'ORCID', href: profiles.orcid },
];
---
<SiteLayout pageType="CollectionPage" schema={schema} title="Research — Sairam Krishnan" description="Research by Sairam Krishnan on AI investment, engineering management, and autonomous systems.">
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader active="research" />
  <main id="main" class="inner-page">
    <section class="inner-hero simple-hero" aria-labelledby="research-title"><h1 id="research-title" data-reveal>Research.</h1></section>
    <section class="research-list" aria-label="Research papers">
      {research.map(paper => <article class="research-row" id={paper.slug} data-reveal>
        <div><span class="research-venue">{paper.venue}</span><h2>{paper.title}</h2>{paper.subtitle && <p class="research-subtitle">{paper.subtitle}</p>}<p class="research-authors">{paper.authors}</p><p class="research-summary">{paper.summary}</p></div>
        {paper.href && <a href={paper.href} target="_blank" rel="noopener noreferrer" aria-label={`Read ${paper.title}`}>{linkLabels[paper.slug]} ↗</a>}
      </article>)}
    </section>
    <nav class="archive-link research-profiles" aria-label="Research profiles">{profileLinks.map(profile => <a href={profile.href} target="_blank" rel="noopener noreferrer">{profile.label} ↗</a>)}</nav>
  </main>
  <SiteFooter />
</SiteLayout>
