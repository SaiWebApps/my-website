---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { services, masterclasses, terms, mailto, money } from '../data/services';
import { personId, SITE } from '../data/seo';
import { featuredRecommendations } from '../data/recommendations';
import '../styles/inner-pages.css';
import '../styles/services.css';

const pad = (n: number) => String(n).padStart(2, '0');
const praise = featuredRecommendations[0];
const peer = featuredRecommendations[1];
const schema = [{
  '@type': 'OfferCatalog',
  '@id': `${SITE}/services#catalog`,
  name: 'Services by Sairam Krishnan',
  itemListElement: services.map(s => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', '@id': `${SITE}/services#${s.id}`, name: s.name, description: s.abstract, provider: { '@id': personId } },
    priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'USD', minPrice: s.price, ...(s.unit ? { unitCode: s.unit } : {}) },
  })),
}];
---
<SiteLayout pageType="CollectionPage" schema={schema} title="Services — Sairam Krishnan" description="I offer architecture calls, design reviews, advisory retainers, masterclasses, keynotes, architecture audits, AI ROI reviews, masterclass series, and evals harnesses, each with my starting price. I designed the Alexa platform that saved $40M a year and led architecture of Apple’s media knowledge graph for over 100 million users.">
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader active="services" />
  <main id="main" class="inner-page services-page">
    <section class="inner-hero services-hero" aria-labelledby="services-title">
      <h1 id="services-title" data-reveal>Services.</h1>
      <p class="services-lede" data-reveal style="--i:1">I lead engineering teams that build AI and data platforms at Apple. There I led an eight-engineer team across Seattle, London, and partner sites in Europe and Latin America, and led architecture of the media knowledge graph for over 100 million users. At Amazon, I designed the Alexa Engine data platform that saved $40M a year. I keynoted the Philadelphia Eagles’ 12th annual Eagles Care Summit for more than 300 community and business leaders and published, as first author, the AI ROI framework behind the AI ROI Review.</p>
      <nav class="svc-links" aria-label="Service list" data-reveal style="--i:2">{services.map(s => <a href={`#${s.id}`}>{s.name}</a>)}</nav>
    </section>

    <section class="ladder" aria-label="Services">
      {services.map((s, i) => <article class="rung" id={s.id} aria-labelledby={`${s.id}-name`} data-reveal>
        <span class="rung-num">{pad(i + 1)}</span>
        <div class="rung-head">
          <h2 id={`${s.id}-name`}>{s.name}</h2>
          <span class="rung-length">{s.length}</span>
        </div>
        <p class="rung-abstract">{s.abstract}</p>
        <div class="rung-price">
          <span class="rung-from">{s.priceLabel}</span>
          <strong>{money(s.price)}</strong>
          <a class="rung-ask" href={mailto(s.name)}>Book</a>
        </div>
        <div class="rung-more">
          {s.figures.length > 0 && <dl class="svc-figures">
            {s.figures.map(f => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
          </dl>}
          <ul class="svc-proof">{s.proof.map(line => <li>{line}</li>)}</ul>
          {s.links && <div class="svc-links">{s.links.map(link => <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}{link.external && <span aria-hidden="true"> ↗</span>}</a>)}</div>}
        </div>
      </article>)}
    </section>

    <figure class="svc-praise" data-reveal>
      <blockquote>{peer.quotes.slice(0, 2).map(quote => <p>“{quote}”</p>)}</blockquote>
      <figcaption>{peer.person} · {peer.role} · {peer.context}</figcaption>
    </figure>

    <figure class="svc-praise" data-reveal>
      <blockquote>“{praise.quotes[1]}”</blockquote>
      <figcaption>{praise.person} · {praise.role} · {praise.context}</figcaption>
    </figure>

    <section class="workshops" id="masterclasses" aria-labelledby="masterclasses-title">
      <div class="workshops-intro" data-reveal>
        <h2 id="masterclasses-title">Masterclasses and keynotes.</h2>
        <p>{terms}</p>
        <div class="svc-links">
          <a href="/speaking">Speaking</a>
          <a href={mailto('Masterclass or keynote')}>Book a session</a>
        </div>
      </div>
      <ul class="catalog" data-reveal style="--i:1">
        {masterclasses.map(m => <li>
          <span class="catalog-org">{m.org}</span>
          <h3>{m.href ? <a href={m.href}>{m.title}</a> : m.title}</h3>
          <p>{m.abstract}</p>
        </li>)}
      </ul>
    </section>

    <section class="services-close" aria-labelledby="close-title">
      <h2 id="close-title" data-reveal>Book an Architecture Call.</h2>
      <a href={mailto('Architecture Call')} data-reveal style="--i:1">Email me</a>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>
