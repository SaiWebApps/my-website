---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { packages, stages, workshops, mailto } from '../data/services';
import { personId, SITE } from '../data/seo';
import '../styles/inner-pages.css';
import '../styles/services.css';

const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(packages.length);
const picks = stages.map(stage => ({
  stage,
  items: stage === 'Masterclasses'
    ? [{ id: 'workshops', ask: workshops.ask }]
    : packages.filter(p => p.stage === stage).map(p => ({ id: p.id, ask: p.ask })),
}));

const offer = (id: string, name: string, description: string, min: number, max: number, unit?: string) => ({
  '@type': 'Offer',
  itemOffered: { '@type': 'Service', '@id': `${SITE}/services#${id}`, name, description, provider: { '@id': personId } },
  priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'USD', minPrice: min, maxPrice: max, ...(unit ? { unitCode: unit } : {}) },
});
const schema = [{
  '@type': 'OfferCatalog',
  '@id': `${SITE}/services#catalog`,
  name: 'Services by Sairam Krishnan',
  itemListElement: [
    ...packages.map(p => offer(p.id, p.tag ? `${p.name}: ${p.tag}` : p.name, p.result, p.offer.min, p.offer.max, p.offer.unit)),
    offer('workshops', 'Masterclasses', [...workshops.executive, ...workshops.engineering].map(w => w.title).join('; '), 5000, 9500),
  ],
}];
---
<SiteLayout pageType="CollectionPage" schema={schema} title="Services — Sairam Krishnan" description="Strategic AI investment reviews, data readiness, high-scale architecture audits, evals, coding-agent transformations, fractional architect advisory, and masterclasses from Sairam Krishnan, with prices.">
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader active="services" />
  <main id="main" class="inner-page services-page">
    <section class="inner-hero services-hero" aria-labelledby="services-title">
      <h1 id="services-title" data-reveal>Services.</h1>
      <div class="picker" data-reveal style="--i:1">
        {picks.map(group => <div class="picker-group">
          <span class="picker-stage">{group.stage}</span>
          {group.items.map(item => <button type="button" class="picker-item" data-pick={item.id}>{item.ask}</button>)}
        </div>)}
      </div>
    </section>

    <section class="deck" aria-label="Service packages" data-deck>
      <div class="deck-bar">
        <span class="deck-count"><span data-count>01</span> / {total}</span>
        <div class="deck-arrows">
          <button type="button" data-prev aria-label="Previous package">←</button>
          <button type="button" data-next aria-label="Next package">→</button>
        </div>
      </div>
      <div class="deck-track" data-track>
        {packages.map((p, i) => <article class="svc-card" id={p.id} data-card aria-labelledby={`${p.id}-name`}>
          <div class="svc-face svc-front" data-front>
            <span class="svc-stage">{p.stage} · {pad(i + 1)}</span>
            <h2 id={`${p.id}-name`}>{p.name}</h2>
            {p.tag && <span class="svc-tag">{p.tag}</span>}
            <p class="svc-problem">“{p.problem}”</p>
            <dl class="svc-figures">
              {p.prices.map(f => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
            </dl>
          </div>
          <div class="svc-face svc-back" id={`${p.id}-steps`} data-back>
            <ol class="svc-steps">
              {p.steps.map(step => <li><strong>{step.title}</strong><span>{step.text}</span></li>)}
            </ol>
            <div class="svc-result">
              <span class="svc-label">{p.resultLabel ?? 'On the last day'}</span>
              <p>{p.result}</p>
            </div>
            {p.figures.length > 0 && <dl class="svc-figures svc-figures-light">
              {p.figures.map(f => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
            </dl>}
            <ul class="svc-proof">{p.proof.map(line => <li>{line}</li>)}</ul>
            {p.quote && <blockquote class="svc-quote"><p>“{p.quote.text}”</p><footer><cite>{p.quote.source}</cite></footer></blockquote>}
            {p.links && <div class="svc-links">{p.links.map(link => <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}{link.external && <span aria-hidden="true"> ↗</span>}</a>)}</div>}
          </div>
          <div class="svc-actions">
            <button type="button" class="svc-flip" data-flip aria-expanded="false" aria-controls={`${p.id}-steps`}>Steps</button>
            <a class="svc-ask" href={mailto(p.tag ? `${p.name}: ${p.tag}` : p.name)}>Ask about {p.askAs ?? p.name}</a>
          </div>
        </article>)}
      </div>
    </section>

    <section class="workshops" id="workshops" aria-labelledby="workshops-title">
      <div id="masterclasses" style="position:relative;top:-80px;"></div>
      <div class="workshops-intro" data-reveal>
        <span class="svc-stage">Masterclasses</span>
        <h2 id="workshops-title">Masterclasses.</h2>
        <dl class="svc-figures svc-figures-light">
          {workshops.prices.map(f => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
        </dl>
        <p>{workshops.keynote}</p>
        <div class="svc-links">
          <a href="/talks/knowledge-graphs" target="_blank" rel="noopener">Knowledge Graphs Deck ↗</a>
          <a href={mailto('Masterclasses')}>Ask about a masterclass</a>
        </div>
      </div>
      <div class="catalog" data-reveal style="--i:1">
        <div>
          <span class="svc-label">Executive & Strategy Track</span>
          <ul>{workshops.executive.map(w => <li><span>{w.title}</span>{w.org && <span class="catalog-org">{w.org}</span>}</li>)}</ul>
        </div>
        <div>
          <span class="svc-label">Systems & Engineering Track</span>
          <ul>{workshops.engineering.map(w => <li><span>{w.title}</span>{w.org && <span class="catalog-org">{w.org}</span>}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="services-close" aria-labelledby="close-title">
      <h2 id="close-title" data-reveal>Start with a call.</h2>
      <a href={mailto('Services')} data-reveal style="--i:1">Email Sairam</a>
    </section>
  </main>
  <SiteFooter />
  <script>
    const deck = document.querySelector<HTMLElement>('[data-deck]');
    const track = deck?.querySelector<HTMLElement>('[data-track]');
    if (deck && track) {
      const cards = [...track.querySelectorAll<HTMLElement>('[data-card]')];
      const count = deck.querySelector<HTMLElement>('[data-count]');
      const picks = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let current = 0;

      const setFlip = (card: HTMLElement, flipped: boolean) => {
        const button = card.querySelector<HTMLButtonElement>('[data-flip]')!;
        card.classList.toggle('is-flipped', flipped);
        if (flipped) card.classList.add('has-flipped');
        button.textContent = flipped ? 'Back' : 'Steps';
        button.setAttribute('aria-expanded', String(flipped));
        card.querySelector<HTMLElement>('[data-front]')!.inert = flipped;
        card.querySelector<HTMLElement>('[data-back]')!.inert = !flipped;
      };
      const mark = (index: number) => {
        current = index;
        if (count) count.textContent = String(index + 1).padStart(2, '0');
        cards.forEach((card, i) => card.classList.toggle('is-current', i === index));
        picks.forEach(pick => pick.setAttribute('aria-pressed', String(pick.dataset.pick === cards[index].id)));
      };
      const go = (index: number) => {
        const i = Math.max(0, Math.min(cards.length - 1, index));
        const pad = parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0;
        track.scrollTo({ left: cards[i].offsetLeft - track.offsetLeft - pad, behavior: reduce ? 'auto' : 'smooth' });
        mark(i);
      };

      cards.forEach(card => {
        setFlip(card, false);
        card.classList.remove('has-flipped');
        card.querySelector('[data-flip]')!.addEventListener('click', () => setFlip(card, !card.classList.contains('is-flipped')));
      });
      deck.querySelector('[data-prev]')!.addEventListener('click', () => go(current - 1));
      deck.querySelector('[data-next]')!.addEventListener('click', () => go(current + 1));
      track.addEventListener('keydown', event => {
        if (event.key === 'ArrowRight') { event.preventDefault(); go(current + 1); }
        if (event.key === 'ArrowLeft') { event.preventDefault(); go(current - 1); }
      });
      let ticking = false;
      track.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const left = track.getBoundingClientRect().left;
          let best = 0;
          cards.forEach((card, i) => {
            if (Math.abs(card.getBoundingClientRect().left - left) < Math.abs(cards[best].getBoundingClientRect().left - left)) best = i;
          });
          if (best !== current) mark(best);
        });
      }, { passive: true });
      picks.forEach(pick => pick.addEventListener('click', () => {
        const id = pick.dataset.pick!;
        if (id === 'workshops') { document.getElementById('workshops')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' }); return; }
        const index = cards.findIndex(card => card.id === id);
        deck.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        go(index);
        cards[index].classList.remove('is-picked');
        void cards[index].offsetWidth;
        cards[index].classList.add('is-picked');
      }));
      const start = cards.findIndex(card => `#${card.id}` === location.hash);
      if (start >= 0) requestAnimationFrame(() => go(start)); else mark(0);
    }
  </script>
</SiteLayout>
