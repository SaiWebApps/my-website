---
import PrototypeLayout from '@/layouts/PrototypeLayout.astro';
import { prototypeContent as content } from '@/data/prototype';
import '@/styles/explore/night-signal.css';
---

<PrototypeLayout
  title="Night Signal | Sairam Krishnan prototype"
  description="A cinematic prototype for Sairam Krishnan."
  current="/explore/night-signal"
  bodyClass="signal-page"
  themeColor="#080d19"
>
  <header class="signal-nav">
    <a href="#top">Sairam Krishnan</a>
    <nav aria-label="Prototype page">
      <a href="#proof">Leadership</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="signal-hero" id="top" aria-labelledby="signal-title">
    <div class="signal-copy">
      <h1 id="signal-title">{content.proposition}</h1>
      <p>{content.orientation}</p>
      <a href="#proof">Enter the work</a>
    </div>

    <div class="signal-stage" aria-label="Portrait of Sairam Krishnan">
      <div class="signal-beam" aria-hidden="true"></div>
      <img src="/assets/portrait-2026.jpg" width="796" height="1000" alt="Sairam Krishnan" />
    </div>

    <div class="signal-words" role="group" aria-label="Leadership focus">
      <button type="button" data-signal="people" aria-pressed="true">People</button>
      <button type="button" data-signal="systems" aria-pressed="false">Systems</button>
      <button type="button" data-signal="outcomes" aria-pressed="false">Outcomes</button>
    </div>
  </section>

  <section class="signal-proof" id="proof" aria-labelledby="signal-proof-title">
    <div class="signal-frame signal-frame-opening">
      <p>{content.caseStudy.organization}</p>
      <h2 id="signal-proof-title">{content.caseStudy.title}</h2>
      <p>{content.caseStudy.tension}</p>
    </div>

    <div class="signal-frame signal-frame-choice">
      <p class="signal-role">{content.caseStudy.responsibility}</p>
      <div class="signal-decisions">
        {content.caseStudy.choices.map((choice) => <p>{choice}</p>)}
      </div>
      <p class="signal-scope">{content.caseStudy.scope}</p>
    </div>

    <div class="signal-frame signal-frame-result">
      <div class="signal-outcomes">
        {content.caseStudy.outcomes.map((outcome) => (
          <div><strong>{outcome.value}</strong><span>{outcome.label}</span></div>
        ))}
      </div>
      <p class="signal-reflection">{content.caseStudy.reflection}</p>
      <blockquote>
        <p>“{content.caseStudy.quote}”</p>
        <cite>{content.caseStudy.quoteSource}</cite>
      </blockquote>
    </div>
  </section>

  <footer class="signal-contact" id="contact">
    <h2>{content.invitation}</h2>
    <a href="mailto:sairambkrishnan@gmail.com?subject=Let%27s%20build%20what%20comes%20next">Start a conversation</a>
  </footer>

  <script>
    const page = document.querySelector('.signal-page');
    document.querySelectorAll('[data-signal]').forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.getAttribute('data-signal');
        if (!page || !value) return;
        page.setAttribute('data-signal-mode', value);
        document.querySelectorAll('[data-signal]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      });
    });
  </script>
</PrototypeLayout>
