---
import MaterialPrototypeLayout from '@/layouts/MaterialPrototypeLayout.astro';
import { research } from '@/data/content';
const credits = [
  'Co-authored with Gajendra Babu Thokala.',
  'First author, with A. Hepp and S. Gandhi. Faculty sponsor: Prof. Gad Allon, The Wharton School. Framework grounded in eight enterprise case studies.',
  'Co-authored with D. Ting. Originated as a Carnegie Mellon capstone in 2014, with a 2026 extension.',
];
---
<MaterialPrototypeLayout title="Research | Sairam Krishnan" description="Research on software engineering apprenticeship, enterprise AI returns, and autonomous drone swarms by Sairam Krishnan." surface="research">
  <header class="surface-hero"><div><h1>Research.</h1></div><p>How we develop engineers, evaluate AI investments, and turn human intent into autonomous action.</p></header>
  <section class="research-manuscripts" aria-label="Publications">
    {research.map((item, index) => <article id={item.slug}>
      <span>{item.venue}</span>
      <h2><a href={item.href}>{item.title}</a></h2>
      <p class="research-thesis">{item.thesis}</p>
      <p>{credits[index]}</p>
      <a href={item.href}>DOI {item.href?.replace('https://doi.org/', '')}</a>
      {item.slug === 'drone-megaddon' && <p><a href="https://doi.org/10.31224/6987">2026 extension · DOI 10.31224/6987</a></p>}
    </article>)}
  </section>
</MaterialPrototypeLayout>
