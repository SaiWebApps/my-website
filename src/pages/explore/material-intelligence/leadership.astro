---
import MaterialPrototypeLayout from '@/layouts/MaterialPrototypeLayout.astro';
import { materialCases, appleReviews } from '@/data/materialEvidence';
---

<MaterialPrototypeLayout
  title="Engineering Leadership | Sairam Krishnan"
  description="Leading Apple's media Knowledge Graph and global Music Credits launch, and saving $40M annually at Amazon Alexa. Team scope, technical decisions, outcomes, and manager reviews."
  surface="leadership"
>
  <header class="surface-hero leadership-hero">
    <div>
      <h1>Engineering leadership.</h1>
    </div>
    <p>Platform architecture, global launches, operational ownership, and the engineers I’ve helped grow at Apple and Amazon.</p>
  </header>

  <section class="case-spine" aria-label="Leadership case studies">
    {materialCases.map((item, index) => (
      <article class="case-fold" id={item.slug} data-fold-reveal style={`--case-index:${index}`}>
        <header class="case-cover">
          <span>{item.organization}</span>
          <h2>{item.title}</h2>
          {item.situation && <p>{item.situation}</p>}
        </header>
        <div class="case-inside">
          <div class="case-responsibility">
            <h3>The responsibility</h3>
            <p>{item.responsibility}</p>
            <p class="case-scope">{item.scope}</p>
          </div>
          {item.decisions.length > 0 && <ol>
            {item.decisions.map((decision) => <li>{decision}</li>)}
          </ol>}
          <div class="case-result">
            <h3>What changed</h3>
            {item.slug === 'music-credits' && <p>{item.result}</p>}
            {item.metrics && <div>{item.metrics.map((metric) => <strong><b>{metric.value}</b>{metric.label}</strong>)}</div>}
          </div>
          {item.slug === 'knowledge-graph' && <a href="#apple-reviews">Read my Apple performance reviews</a>}
        </div>
      </article>
    ))}
    <section class="apple-reviews" id="apple-reviews" aria-labelledby="apple-reviews-title">
      <h2 id="apple-reviews-title">From my Apple reviews</h2>
      {appleReviews.map((review) => <blockquote>
        {review.quotes.map((quote) => <p>“{quote}”</p>)}
        <cite>From Apple Senior Engineering Manager, {review.year}</cite>
      </blockquote>)}
    </section>
  </section>
</MaterialPrototypeLayout>
