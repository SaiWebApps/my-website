---
import MaterialPrototypeLayout from '@/layouts/MaterialPrototypeLayout.astro';
import { materialMetrics } from '@/data/materialPrototype';
const base = Astro.url.pathname.startsWith('/explore/') ? '/explore/material-intelligence' : '';
---

<MaterialPrototypeLayout
  title="Sairam Krishnan | Software engineering leader"
  description="Software engineering leader with 11 years of experience at Apple, Amazon, Microsoft, and SIG. Teams, platforms serving 100M+ users, and $40M in annual savings."
  surface="home"
>
  <section class="material-hero" aria-labelledby="material-title">
    <div class="hero-sheet">
      <div class="hero-copy-plane">
        <h1 id="material-title">Grow the people.<br />The platforms follow.</h1>
        <p class="hero-orientation">Software engineering leader building teams and platforms that turn ambitious technology into adopted, measurable outcomes.</p>
        <div class="hero-actions">
          <a href={`${base}/leadership`}>See the leadership record</a>
          <a href="/assets/Sairam_Krishnan_Resume.pdf">Open résumé</a>
        </div>
      </div>
      <figure class="hero-portrait-plane">
        <img src="/assets/portrait-2026.jpg" width="796" height="1000" alt="Sairam Krishnan" />
      </figure>
    </div>
  </section>

  <section class="metric-hinge" aria-label="Leadership evidence">
    {materialMetrics.map((metric, index) => (
      <button class="metric-trigger" type="button" id={`metric-${index}`} aria-expanded="false" aria-controls={`metric-evidence-${index}`}><strong>{metric.value}</strong><span>{metric.label}</span></button>
    ))}
    {materialMetrics.map((metric, index) => (
      <div class="metric-evidence" id={`metric-evidence-${index}`} role="region" aria-labelledby={`metric-${index}`} hidden>
        <p>{metric.detail}</p>
        <a href={metric.href.replace('/explore/material-intelligence', base)}>{metric.action}</a>
      </div>
    ))}
  </section>

  <section class="home-route-map" aria-label="Explore the record">
    <a class="route-plane route-leadership" href={`${base}/leadership`} data-fold-reveal>
      <span>Leadership</span>
      <strong>Global teams. Platforms at scale.</strong>
      <small>Apple Knowledge Graph, Music Credits, Amazon Alexa</small>
    </a>
    <a class="route-plane route-work" href={`${base}/projects`} data-fold-reveal>
      <span>Projects</span>
      <strong>Products I build, end to end.</strong>
      <small>Independent products, developer tools, repository status</small>
    </a>
    <a class="route-plane route-research" href={`${base}/research`} data-fold-reveal>
      <span>Research</span><strong>Engineering talent. AI returns. Autonomous systems.</strong><small>Papers, collaborators, and publication records</small>
    </a>
    <a class="route-plane route-record" href={`${base}/record`} data-fold-reveal>
      <span>Full Record</span>
      <strong>Eleven years of building and leading.</strong>
      <small>Career, education, honors, recommendations, archive</small>
    </a>
  </section>
</MaterialPrototypeLayout>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>('.metric-trigger');
  triggers.forEach((trigger) => trigger.addEventListener('click', () => {
    const opening = trigger.getAttribute('aria-expanded') !== 'true';
    triggers.forEach((button) => {
      const expanded = button === trigger && opening;
      button.setAttribute('aria-expanded', String(expanded));
      document.getElementById(button.getAttribute('aria-controls')!)!.hidden = !expanded;
    });
  }));
</script>
<noscript><style>.metric-evidence[hidden] { display: block; }</style></noscript>
