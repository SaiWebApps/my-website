---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ventures, research } from '../data/content';
import { careerById, eaglesSummitSources } from '../data/career';
import { featuredRecommendations } from '../data/recommendations';
import '../styles/home.css';

const proof = [
  { id: 'apple', org: 'Apple', value: '100M+', label: 'users on the media knowledge graph', lines: [1, 0] },
  { id: 'apple', org: 'Apple', value: '30%', label: 'higher team velocity', lines: ['Set the design-review and CI/CD standards that lifted team velocity 30%.', 7] },
  { id: 'apple', org: 'Apple', value: '45%', label: 'fewer production incidents', lines: ['Cut production incidents 45% with those same standards.', 4] },
  { id: 'amazon', org: 'Amazon Alexa', value: '$40M', label: 'saved a year', lines: ['Designed a GraphQL data-aggregation and caching platform for the Alexa Engine, saving $40M a year.', 0] },
  { id: 'amazon', org: 'Amazon Alexa', value: '40%', label: 'higher model accuracy', lines: ['Lifted Alexa model accuracy 40% with the same platform, whose annotation-driven rule engine batched and clustered results to the right downstream services.', 2] },
  { id: 'amazon', org: 'Amazon Alexa', value: '15 min', label: 'to onboard a new partner', lines: [3, 4] },
  { id: 'praxtera', org: 'Praxtera', value: '300+', label: 'leaders at the Eagles Care Summit', lines: [1, 0], sources: eaglesSummitSources, talk: '/speaking#eagles' },
  { id: 'wharton', org: 'Wharton', value: 'Top 5%', label: 'of the Executive MBA class', lines: [0, 1, 2] },
].map(step => {
  const entry = careerById[step.id];
  return { ...step, role: entry.role, dates: entry.dates, lines: step.lines.map(line => typeof line === 'number' ? entry.bullets[line] : line) };
});

const praise = featuredRecommendations[0];

const chapters = [
  { id: 'services', title: 'Services', description: 'Architecture calls and reviews, architecture audits, AI ROI reviews, evals harnesses, advisory retainers, masterclasses, and keynotes.' },
  { id: 'speaking', title: 'Speaking', description: 'The Eagles Care Summit keynote, plus talks, courses, and workshops for HP, Morgan Lewis, PBS, Atos, and Carnegie Mellon.' },
  { id: 'career', title: 'Career', description: 'Apple, Amazon Alexa, Praxtera, SIG, and Microsoft, with Wharton honors and an M.S. from Carnegie Mellon with a 4.00 GPA.' },
  { id: 'research', title: 'Research', description: `${research.length} papers on AI investment, engineering teams, and drone-swarm control, including the AI ROI framework I published as first author.` },
  { id: 'projects', title: 'Projects', description: `${ventures.length} products and tools I built: Ondoway, Persuaider, Lore / DependIQ, and Crucible.` },
];

const closing = [
  { label: 'Email', href: 'mailto:sairambkrishnan@gmail.com' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/sairambkrishnan', external: true },
  { label: 'Resume', href: '/assets/Sairam_Krishnan_Resume.pdf', external: true },
];
---
<SiteLayout title="Sairam Krishnan — Senior Engineering Leader, Apple AI/ML" description="I lead engineering teams that build AI and data platforms at Apple, including the media knowledge graph for over 100 million users." pageType="ProfilePage">
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader active="home" />

  <main id="main" class="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-image" aria-hidden="true"></div>
      <div class="hero-content">
        <h1 id="hero-title" data-reveal>I lead engineering teams at <em>Apple.</em></h1>
        <div class="hero-bottom" data-reveal style="--i:2">
          <p>I led architecture of Apple’s media knowledge graph for over 100 million users, designed the data platform for Amazon’s Alexa Engine that saved $40M a year, keynoted the Philadelphia Eagles’ Eagles Care Summit for more than 300 leaders, and earned Palmer Scholar honors (top 5% of class) in Wharton’s Executive MBA.</p>
          <a class="hero-cue" href="#results" aria-label="Scale and results"><span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </section>

    <section class="proof" id="results" aria-labelledby="proof-title" data-proof>
      <div class="proof-sticky" aria-hidden="true">
        <p class="proof-title-mirror">Scale and <em>results.</em></p>
        <div class="proof-numbers">
          {proof.map((step, i) => <div class:list={['proof-number', { 'is-active': i === 0 }]} data-i={i}>
            <span>{step.org}</span>
            <strong>{step.value}</strong>
            <p>{step.label}</p>
          </div>)}
        </div>
      </div>
      <div class="proof-steps">
        <h2 id="proof-title" class="proof-title" data-reveal>Scale and <em>results.</em></h2>
        {proof.map((step, i) => <article class:list={['proof-step', { 'is-active': i === 0 }]} data-step={i}>
          <div class="proof-inline-number" data-reveal>
            <span>{step.org}</span>
            <strong>{step.value}</strong>
            <p>{step.label}</p>
          </div>
          <div class="proof-body" data-reveal style="--i:1">
            <span class="proof-meta">{step.org} · {step.role} · {step.dates}</span>
            {step.lines.map(line => <p>{line}</p>)}
            <div class="proof-links">
              <a href={`/career#entry-${step.id}`}>Full chapter →</a>
              {step.talk && <a href={step.talk}>Speaking →</a>}
              {step.sources?.map(source => <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>)}
            </div>
          </div>
        </article>)}
      </div>
    </section>

    <figure class="praise" data-reveal>
      <blockquote><p>“{praise.quotes[0]}”</p></blockquote>
      <figcaption>{praise.person} · {praise.role} · {praise.context}</figcaption>
    </figure>

    <section class="chapters" aria-label="Services, Speaking, Career, Research, and Projects">
      {chapters.map((chapter, i) => <a class={`chapter-card chapter-${chapter.id}`} href={`/${chapter.id}`} data-reveal style={`--i:${i}`}>
        <span class="chapter-glow" aria-hidden="true"></span>
        <h2>{chapter.title}</h2>
        <p>{chapter.description}</p>
      </a>)}
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="closing-image" aria-hidden="true"></div>
      <div class="closing-content">
        <h2 id="closing-title" data-reveal>Contact.</h2>
        <div class="closing-links" data-reveal style="--i:1">
          {closing.map(link => <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}{link.external && <span aria-hidden="true"> ↗</span>}</a>)}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
  <script>
    const section = document.querySelector<HTMLElement>('[data-proof]');
    if (section && 'IntersectionObserver' in window) {
      const steps = [...section.querySelectorAll<HTMLElement>('[data-step]')];
      const numbers = [...section.querySelectorAll<HTMLElement>('.proof-number')];
      const activate = (index: number) => {
        steps.forEach((step, i) => step.classList.toggle('is-active', i === index));
        numbers.forEach((number, i) => number.classList.toggle('is-active', i === index));
      };
      const io = new IntersectionObserver(entries => {
        for (const entry of entries) if (entry.isIntersecting) activate(Number((entry.target as HTMLElement).dataset.step));
      }, { rootMargin: '-45% 0px -45% 0px' });
      steps.forEach(step => io.observe(step));
    }
  </script>
</SiteLayout>
