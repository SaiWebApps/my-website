---
import Analytics from '@vercel/analytics/astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import newsreaderUrl from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import instrumentSansUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import martianMonoUrl from '@fontsource-variable/martian-mono/files/martian-mono-latin-wght-normal.woff2?url';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import globalCss from '@/styles/global.css?inline';

interface Props {
  title: string;
  description: string;
  path?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, path = '/', imageAlt = 'Sairam Krishnan, AI and ML engineering leader', jsonLd } = Astro.props;
const canonical = new URL(path, Astro.site);
const currentPath = Astro.url.pathname;
const enableAnalytics = import.meta.env.VERCEL === '1';
const fontCss = `
@font-face{font-family:'Newsreader Variable';font-style:normal;font-display:swap;font-weight:200 800;src:url('${newsreaderUrl}') format('woff2-variations')}
@font-face{font-family:'Instrument Sans Variable';font-style:normal;font-display:swap;font-weight:400 700;src:url('${instrumentSansUrl}') format('woff2-variations')}
@font-face{font-family:'Martian Mono Variable';font-style:normal;font-display:swap;font-weight:100 800;src:url('${martianMonoUrl}') format('woff2-variations')}
@font-face{font-family:'Archivo Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url('${archivoUrl}') format('woff2-variations')}
`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Sairam Krishnan" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
    <meta name="theme-color" content="#f2eee5" />
    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={instrumentSansUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <style is:inline set:html={`${fontCss}\n${globalCss}`} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sairam Krishnan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://sairambkrishnan.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://sairambkrishnan.com/og.png" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      })();
    </script>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {enableAnalytics && <Analytics />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header currentPath={currentPath} />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      import { track } from '@vercel/analytics';
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('[data-analytics]') : null;
        const name = target?.getAttribute('data-analytics');
        if (name) track(name);
      });
    </script>
  </body>
</html>
