---
import PrototypeLayout from '@/layouts/PrototypeLayout.astro';
import '@/styles/explore/material-intelligence.css';

interface Props {
  title: string;
  description: string;
  surface: 'home' | 'leadership' | 'work' | 'record' | 'research' | 'contact';
}

const { title, description, surface } = Astro.props;
const base = Astro.url.pathname.startsWith('/explore/') ? '/explore/material-intelligence' : '';
const pageUrl = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;
const personId = 'https://sairambkrishnan.com/#person';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', '@id': personId, name: 'Sairam Krishnan', url: 'https://sairambkrishnan.com/', jobTitle: 'Software engineering leader', sameAs: ['https://linkedin.com/in/sairambkrishnan', 'https://github.com/SaiWebApps'] },
    { '@type': surface === 'contact' ? 'ContactPage' : 'WebPage', '@id': pageUrl, url: pageUrl, name: title, description, about: { '@id': personId }, inLanguage: 'en' },
  ],
};
const routes = [
  { key: 'home', label: 'Home', href: '/explore/material-intelligence' },
  { key: 'leadership', label: 'Leadership', href: '/explore/material-intelligence/leadership' },
  { key: 'work', label: 'Projects', href: '/explore/material-intelligence/projects' },
  { key: 'research', label: 'Research', href: '/explore/material-intelligence/research' },
  { key: 'record', label: 'Full Record', href: '/explore/material-intelligence/record' },
] as const;
---

<PrototypeLayout
  {title}
  {description}
  current="/explore/material-intelligence"
  bodyClass={`material-world material-${surface}`}
  themeColor="#171933"
  indexable={!base}
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="https://sairambkrishnan.com/assets/portrait-2026.jpg" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />
  </Fragment>
  <div class="material-atmosphere" aria-hidden="true"><span></span><span></span><span></span></div>
  <header class="material-nav">
    <a class="material-name" href={base || '/'}>Sairam Krishnan</a>
    <nav aria-label="Main navigation">
      {routes.map((route) => <a href={route.href.replace('/explore/material-intelligence', base) || '/'} aria-current={surface === route.key ? 'page' : undefined}>{route.label}</a>)}
    </nav>
    <a class="material-contact" href={`${base}/contact`} aria-current={surface === 'contact' ? 'page' : undefined}>Contact Me</a>
  </header>
  <slot />

</PrototypeLayout>
