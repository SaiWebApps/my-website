{
  "version": 1,
  "routes": [
    {"id": "index", "file": "index.html"},
    {"id": "services", "file": "services.html"},
    {"id": "speaking", "file": "speaking.html"},
    {"id": "career", "file": "career.html"},
    {"id": "research", "file": "research.html"},
    {"id": "projects", "file": "projects.html"},
    {"id": "contact", "file": "contact.html"}
  ],
  "viewports": [
    {"width": 375, "height": 812},
    {"width": 1440, "height": 900}
  ],
  "themes": ["light", "dark"],
  "discoverySelector": "dialog, details, [data-ride], [data-career-ride], [data-cars], [data-blind], [data-screen], [role=tablist], [aria-expanded], [aria-controls], [aria-pressed]",
  "families": [
    {"id": "theme", "root": "[data-theme-toggle]", "mode": "theme-context"},
    {"id": "dialog", "root": "dialog", "trigger": "[aria-haspopup=dialog]", "mode": "every-open-state"},
    {"id": "ride", "root": "[data-ride]", "mode": "every-triggered-state"},
    {"id": "career", "root": "[data-career-ride]", "mode": "every-station"},
    {"id": "horizontal", "root": "[data-cars]", "mode": "keyboard-controls"},
    {"id": "blind", "root": "[data-blind]", "mode": "every-button-state"},
    {"id": "disclosure", "root": "details", "mode": "all-open-representative"}
  ]
}
