    {
      "factId": "resume:research:drone-megaddon",
      "field": "citation",
      "show": "must",
      "source": "resume",
      "text": "Drone-Megaddon: A Real-Time Strategy Interface for Managing Drone Swarms Sairam Krishnan, Daniel Ting. Carnegie Mellon course project, 2014; archived on engrXiv, 2026. doi:10.31224/6924 Built an end-to-end Android, Zigbee radio, and embedded-control prototype using a real-time strategy interface.",
      "textSha256": "da3c1de166a60e253645ec5540a25279a49b9bb69c3e62ef0e136d2429c86d53",
      "unit": "drone-megaddon"
    },
    {
      "factId": "resume:research:drone-megaddon-2026",
      "field": "citation",
      "show": "must",
      "source": "resume",
      "text": "Drone-Megaddon 2026: Co-Intelligent Swarm Control with Language and Vision Models Sairam Krishnan, Daniel Ting. engrXiv preprint, 2026. doi:10.31224/6987 Proposes language-intent, visual-grounding, and multi-drone coordination layers with operator inspection gates, audit logs, and manual-control fallback under degraded connectivity. Illustrated through a search-and-rescue scenario.",
      "textSha256": "81ac05cc1364a13c63c3aefd2e31dfee08f005e8c85bd1b710b47740a7f6b069",
      "unit": "drone-megaddon-2026"
    },
    {
      "factId": "resume:research:who-trains",
      "field": "citation",
      "show": "must",
      "source": "resume",
      "text": "Who Trains the Next Senior? Managing Software Engineering When AI Makes Code Cheap Gajendra Babu Thokala, Sairam Krishnan. SSRN working paper, 2026. doi:10.2139/ssrn.7083078 Examines \"review theater\": approvals that no longer meaningfully verify AI-generated work. Proposes smaller reviewable changes, scrutiny matched to consequence, deliberate apprenticeship, and measurement of verified outcomes rather than code volume.",
      "textSha256": "cbd52e47ca3df6b71359715f4f50797221a26d76963715921e704e8a26ae1748",
      "unit": "who-trains"
    },
    {
      "factId": "resume:research:ai-roi",
      "field": "citation",
      "show": "must",
      "source": "resume",
      "text": "A Multi-Layer Framework for Evaluating the Return on Investment of AI Projects Sairam Krishnan, Sonia Gandhi, Andrea Hepp. SSRN working paper, 2026. doi:10.2139/ssrn.6732598 Integrates readiness, ROIC value drivers, staged investment, and a decision scorecard with eight categories of AI risk, including vendor dependency and organizational friction. Eight illustrative public-company cases examine inference costs and organizational readiness. Wharton independent study; faculty sponsor Professor Gad Allon.",
      "textSha256": "075daff00b4ed6c00bfaeda181c3c6b5fa32b96a710ca747e2feefbe9c05b351",
      "unit": "ai-roi"
    }
