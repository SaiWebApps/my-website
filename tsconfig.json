{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "exclude": [
    "dist",
    "public",
    "site",
    "decks",
    "brand/sources/legacy-site"
  ],
  "include": [
    "src/**/*"
  ]
}
