{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --ignore-scripts && python3 -m pip install --disable-pip-version-check --no-input -r requirements.txt",
  "buildCommand": "python3 .claude/rubric/score.py --deploy-build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/(letters|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ventures",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/work-with-me",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/leadership",
      "destination": "/career",
      "permanent": true
    },
    {
      "source": "/record",
      "destination": "/career",
      "permanent": true
    },
    {
      "source": "/explore",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/explore/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    }
  ]
}
